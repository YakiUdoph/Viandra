# Create a key at https://console.openserv.ai/ and keep it server-side.
SERV_API_KEY=

# Verified SERV catalog model. Override deliberately if needed.
SERV_MODEL=gpt-6-luna

# Per Node process/serverless instance. This is not a global distributed limit.
SERV_REQUESTS_PER_HOUR=20

# Optional local port.
PORT=3000
